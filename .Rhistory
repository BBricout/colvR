## Libraries
library(lori) ; library(missForest) ; library(ggplot2) ; library(colvR)
## Données souchet
Souchet <-
read.csv2("~/Code/lori_northern_shoveler/souchet.csv",
sep = ";")
sites <- Souchet$site
Souchet <- Souchet[,2:29] ; Souchet <- Souchet[,12:28] ; Souchet <- as.matrix(Souchet)
n <- nrow(Souchet) ; p <- ncol(Souchet)
cov_sites <- read.csv2("~/Code/lori_northern_shoveler/cov_sites.csv", sep = ";")
cov_sites <- cov_sites[, 2:11]
cov_sites$ecosystem.1 <- 1*(cov_sites$ecosystem==1)
cov_sites$ecosystem.2 <- 1*(cov_sites$ecosystem==2)
cov_sites$ecosystem.3 <- 1*(cov_sites$ecosystem==3)
cov_sites <- cov_sites[, -10]
cov_sites[,5:9] <- scale(cov_sites[,5:9])
cov_years <-
read.csv2("~/Code/lori_northern_shoveler/cov_years.csv",
sep = ";")
cov_years <- scale(cov_years[12:28, 2:8])
covariates <-cbind(rep(1, n*p), covmat(n,p,cov_sites, cov_years, center = F))
colnames(covariates)[1] <- "Intercept" ; d <- ncol(covariates)
q <- 2 ; tx <- mean(is.na(Souchet))
load("~/Code/Souchet_Afrique_reducted.Rdata")
B <- fit$mStep$beta ; D <- fit$mStep$gamma ; dim <- list(n = n, p = p, d = d, q = q)
X <- covariates ; R <- ifelse(is.na(Souchet), 0, 1)
hist(rowSums(fit$eStep$S))
data <- list(Y = Souchet, X = X, R = R)
params <- list(B = fit$mStep$beta, D = fit$mStep$gamma, C = fit$mStep$C,
M = fit$eStep$M, S = fit$eStep$S)
grad <- Elbo_grad(data = data, params = params, tolxi = 1e-04)
hist(rowSums((grad$gradS)**2))
hist(log10(Souchet+1))
colMeans(is.na(Souchet)) ; apply(Souchet, 2, "sd", na.rm = TRUE)
plot(colMeans(is.na(Souchet)), apply(Souchet, 2, "sd", na.rm = TRUE))
mean(Souchet == 0, na.rm = TRUE)
colMeans(Souchet == 0, na.rm = TRUE)
colMeans(Souchet, na.rm = TRUE)
C <- matrix(rnorm(p*q)/5, nrow = p, ncol = q)
theta1 <- list(B = B, D = D, C = C)
sim1 <- Simul(X, theta1, dim) ; Y1 <- sim1$Y
Y1.na <- prodNA(Y1, tx) ; data <- list(Y = Y1.na, X = X, R = ifelse(is.na(Y1.na), 0, 1))
colMeans(Y1.na, na.rm = TRUE)
Y2 <- Y1 ; Y2.na <- ifelse(R == 0, NA, Y2)
C <- fit$mStep$C
theta3 <- list(B = B, D = D, C = C)
sim3 <- Simul(X, theta3, dim) ; Y3 <- sim3$Y
Y3.na <- prodNA(Y1, tx) ; data <- list(Y = Y3.na, X = X, R = ifelse(is.na(Y3.na), 0, 1))
colMeans(Y4.na, na.rm = TRUE) ; apply(Y4, 2, "sd")
colMeans(Y3.na, na.rm = TRUE) ; apply(Y3, 2, "sd")
colMeans(Souchet, na.rm = TRUE)
colMeans(Y4)
colMeans(Y3)
colMeans(Y2)
C <- matrix(rnorm(p*q), nrow = p, ncol = q)
theta5<- list(B = B, D = D, C = C)
sim5 <- Simul(X, theta5, dim) ; Y5 <- sim5$Y
colMeans(Souchet, na.rm = TRUE)
colMeans(Y5, na.rm = TRUE)
apply(Souchet, 2, sd, na.rm = TRUE)
apply(Y5, 2, sd, na.rm = TRUE)
B
plot(X%*%B)
D
Hist(VectorToMatrix(X%*%B), n, p)
hist(VectorToMatrix(X%*%B), n, p)
hist(VectorToMatrix(X%*%B, n, p))
hist(exp(VectorToMatrix(X%*%B, n, p)))
hist(Souchet)
hist(Y5)
hist(rowMeans(Souchet))
hist(rowMeans(Y5$))
hist(rowMeans(Y5))
hist(log10(1+Souchet))
hist(log10(1+Y5))
head(Y5)
head(Souchet)
mean(Y5)
mean(Souchet)
mean(Souchet, na.rm = TRUE)
# Trouver les indices des 5 plus grandes moyennes
top5_indices <- order(rowMeans(Souchet), decreasing = TRUE)[1:5]
# Extraire les lignes correspondantes
less_rows <- Souchet[-top5_indices, ]
mean(Y5)
mean(less_rows)
mean(less_rows, na.rm = TRUE)
plot(rowMeans(Souchet, na.rm = TRUE))
rowMeans(Souchet, na.rm = TRUE)
# Indices des lignes dont la moyenne est < 100
indices_inf_100 <- which(rowMeans(Souchet, na.rm = TRUE) > 100)
length(indices_inf_100)
Y[indices_inf_100, ]
Souchet[indices_inf_100, ]
mean(Y5)
# Extraire les lignes correspondantes
