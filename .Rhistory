devtools::load_all()
install.packages("~/Code/colvR_0.1.0.tar.gz", repos = NULL, type = "source")
library(colvR)
# 1) Fichiers standard
usethis::use_news_md()
usethis::use_readme_rmd()
usethis::use_citation()          # optionnel, mais pro
usethis::use_mit_license("Barbara Bricout")  # ou une autre licence
# 2) (optionnel) brouillon pour CRAN
usethis::use_cran_comments()
rmarkdown::render("README.Rmd")
usethis::use_github_actions_check_full()
usethis::git_sitrep()
usethis::use_github_actions_check_full()
usethis::use_github_actions()
usethis::use_github_action("check-standard")
usethis::use_git_message("CI: add R-CMD-check workflow")
usethis::use_pkgdown()
usethis::use_github_actions("pkgdown")  # déploiement auto sur GitHub Pages
usethis::use_github_action("pkgdown")  # déploiement auto sur GitHub Pages
usethis::use_description_field("URL", c(
"https://github.com/BBricout/colvR",
"https://BBricout.github.io/colvR/"
))
install.packages("desc")  ; library(desc)
desc::desc_set("URL", c(
"https://github.com/BBricout/colvR",
"https://BBricout.github.io/colvR/"
))
# une seule chaîne, séparée par une virgule
desc::desc_set("URL", "https://github.com/BBricout/colvR, https://BBricout.github.io/colvR/")
desc::desc_set("BugReports", "https://github.com/BBricout/colvR/issues")
# vérifier
desc::desc_get("URL")
desc::desc_get("BugReports")
usethis::use_vignette("getting-started")
devtools::build_vignettes()
usethis::use_testthat()
test_that("IC returns 95% CI", {
expect_equal(IC(1, 0.04), c(0.608, 1.392), tolerance = 1e-12)
expect_length(IC(0, 1), 2)
})
install.packages("testthat") ; library(testthat)
