source("~/Code/Utils/Simul_function.R")
n <- 1500 ; p <- 30 ; q <- 4 ; d <- 4
dim <- list(n = n, p = p, d = d, q = q)
X <- cbind(rep(1, n*p), rnorm(n*p), rep(rnorm(n), p))
trend <- rep(1:p, each = n)
X <- cbind(X, scale(trend))
B <- c(1, 0.7, 0.5, -0.6) ; D <- c(0.7, 0.5, 0.3, -0.4) ; C <- matrix(rnorm(p*q)/5, nrow = p, ncol = q)
theta <- list(B = B, D = D, C = C)
diag(var(VectorToMatrix(X%*%B, n, p)))
diag(var(VectorToMatrix(X%*%D, n, p)))
diag(C%*%t(C))
sim <- Simul(X, theta, dim)
hist(exp(-sim$Lambda))
Y <- sim$Y
hist(Y)
mean(Y == 0)
Y.na <- prodNA(Y, 0)
config_vem <- list(maxiter = 1000, ftol = 1e-02, xtol = 1e-02,
tolS = list(lower = 1e-04, upper = 1), tolxi = 0)
# Proportions de données manquantes
missing_rates <- c(0, 0.05, 0.2, 0.4, 0.6, 0.8)
# Liste pour stocker les résultats
results <- list()
# Masque initial complet (aucune donnée manquante)
R <- matrix(1, nrow = n, ncol = p)
for (rate in missing_rates) {
cat("Traitement du taux de données manquantes :", rate, "\n")
# Calcul du nombre total de données à rendre manquantes
total_missing <- floor(rate * n * p)
current_missing <- sum(R == 0)
new_missing <- total_missing - current_missing  # Données supplémentaires à rendre manquantes
if (new_missing > 0) {
# Sélectionner aléatoirement les indices à rendre manquants
candidates <- which(R == 1, arr.ind = TRUE)  # Indices observés
new_indices <- candidates[sample(1:nrow(candidates), new_missing), ]
# Appliquer les nouvelles données manquantes
R[new_indices] <- 0
# Garantir qu'il reste au moins une observation par ligne
R[rowSums(R) == 0, sample(ncol(R), 1)] <- 1
}
# Génération des données manquantes dans Y
Y.na <- ifelse(R == 0, NA, Y)
print(mean(is.na(Y.na)))
# q <- which.max(unlist(bic)[is.finite(unlist(bic))])
# Ajustement
#fit.na <- Miss.ZIPLNPCA(Y.na, X, q)
fit.na <- Miss.ZIPLNPCA(Y, X, q)
#fits[[as.character(rate)]] <- list(Y = Y.na, fit = fit.na)
# Variance et IC
vartest.na <- diag(V_theta(Y.na, X, fit.na))[1:(2*d)]
IC_gamma.na <- IC(fit.na$mStep$gamma, vartest.na[1:d])
IC_beta.na <- IC(fit.na$mStep$beta, vartest.na[(d+1):(2*d)])
# Stocker les résultats
results[[as.character(rate)]] <- data.frame(
# Index =  c("Intercept.D", "Year.D", "PC1.D", "PC2.D", "PC3.D", "PC4.D",
#            "Intercept.B", "Year.B", "PC1.B", "PC2.B", "PC3.B", "PC4.B"),
Index <- c(paste0(colnames(X), ".gamma"), paste0(colnames(X), ".beta")),
Value = c(fit.na$mStep$gamma, fit.na$mStep$beta),
Lower = c(IC_gamma.na[1:d], IC_beta.na[1:d]),
Upper = c(IC_gamma.na[(d+1):(2*d)], IC_beta.na[(d+1):(2*d)])
)
}
rm(list=ls()) ; par(mfrow = c(1,1))
