m <- 1000
n <- 1500 ; p <- 30 ; q <- 4 ; d <- 4
dim <- list(n = n, p = p, d = d, q = q)
X <- cbind(rep(1, n*p), rnorm(n*p), rep(rnorm(n), p))
trend <- rep(1:p, each = n)
X <- cbind(X, scale(trend))
B <- c(2, 0.7, 0.5, -0.6) ; D <- c(-0.5, 0.5, 0.4, -0.4) ; C <- matrix(rnorm(p*q), nrow = p, ncol = q)
theta <- list(B = B, D = D, C = C)
sim <- Simul(X, theta, dim) ; Y <- sim$Y
select_model_bic <- function(Y, X, fun, latents){
fits <- pblapply(latents, function(j)
fun(Y = Y, X = X, q = latents[j]))
bic <- unlist(lapply(latents, function(j)
BIC(Y, X, fits[[j]], latents[[j]])))
return(bic)
}
get_q_star <- function(Ym, Xm, fun, q_grid) {
# returns q* minimizing BIC over q_grid
bic_vec <- select_model_bic(Y = Ym, X = Xm, fun = fun, latents = q_grid)
q_grid[ which.min(bic_vec) ]
}
q_grid <- 1:10
fit_PLNPCA <- function(Ym, Xm) {
q_star <- get_q_star(Ym, Xm, fun = colvR::Miss.PLNPCA, q_grid = q_grid)
fit    <- colvR::Miss.PLNPCA(Y = Ym, X = Xm, q = q_star)
list(fit = fit, q = q_star)
}
get_q_star(Y, X, fun = colvR::Miss.PLNPCA, q_grid = q_grid)
