mean(less_rows)
mean(less_rows, na.rm = TRUE)
C <- matrix(rnorm(p*q), nrow = p, ncol = q)
theta5 <- list(B = B, D = D, C = C)
sim5 <- Simul(X, theta5, dim) ; Y5 <- sim5$Y
indices <- which(rowMeans(Souchet, na.rm = TRUE) > 100)
Y5[indices,] <- Souchet[indices, ]
head(Y5)
