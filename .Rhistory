library(colvR)
library(Matrix)
source("~/Code/Utils/Simul_function.R")
load("~/Code/Data_sim/params_simu_fr_it.Rdata")
load("~/Code/Data_sim/trueTheta.Rdata")
load("~/Code/Data_sim/Covariates.Rdata")
X <- params$X
X <- X[, c(1, 5, 9, 16)]
theta <- trueTheta
theta$B <- theta$B[c(1, 5, 9, 16)]
theta$D <- theta$D[c(1, 5, 9, 16)]
dim <- params$dim
q <- dim$q
n <- dim$n
p <- dim$p
d <- 4
Y <- Simul(X, theta, dim)
R <- ifelse(is.na(Y), 0, 1)
B <- theta$B
D <- theta$B
C <- theta$C
fit <- Miss.ZIPLNPCA(Y, X, q)
M <- fit$eStep$M
S <- fit$eStep$S
A <- fit$pred$A
mu <- VectorToMatrix(X%*%B, n, p)
nu <- VectorToMatrix(X%*%D, n, p)
pi <- 1/(1 + exp(-nu))
xi <- plogis(nu - R * A)
row <- sapply(1:p-1, function(k) k * n + 1)
indices <- lapply(1:n, function(i)
sapply(1:p-1, function(k) k * n + i))
# grad2gamma <- sum(xi[1,] - pi[1,]) * t(X[row,]) %*% X[row,]
grad2gamma <- lapply(1:n, function(i)
sum(xi[i,] - pi[i,]) * t(X[indices[[i]],])%*%X[indices[[i]],])
# grad2beta <- sum(R[1,] * xi[1,] * A[1,])*t(X[row,])%*%X[row,]
grad2beta <- lapply(1:n, function(i)
sum(R[i,]*xi[i,]*A[i,]) * t(X[indices[[i]],])%*%X[indices[[i]],])
grad2C1 <- R[1,1]*xi[1,1]*A[1,1] * (M[1,]%*%t(M[1,]) + 2 * (C[1,]*S[1,])%*%t(M[1,]) + (C[1,]*S[1,])%*%t(C[1,]*S[1,]))
grad2C <- vector("list", p)
for (j in 1:p){
grad2C[[j]] <- lapply(1:n, function(i)
R[i,j]*xi[i,j]*A[i,j] * (M[i,]%*%t(M[i,]) + 2 * (C[j,]*S[i,])%*%t(M[i,]) + (C[j,]*S[i,])%*%t(C[j,]*S[i,])))
}
preptoX <- function(vec, p){return(matrix(rep(vec, p), ncol = p))}
gradBC <- vector("list", p)
for (j in 1:p){
gradBC[[j]] <- lapply(1:n, function(i)
-R[i,j] * xi[i,j] * A[i,j] * (preptoX(M[i,], p) + preptoX(C[j,] * S[i,], p)) %*% X[indices[[i]],])
}
rm(list=ls())
