library(colvR) ; library(lori) ; library(caret) ; library(Matrix)
Y <- Data_clustered$Y1 ; X <- Data_clustered$X1
n <- nrow(Y) ; p <- ncol(Y) ; d <- ncol(X)
rm <- which.max(rowMeans(Y, na.rm = TRUE))
indices <- unlist(lapply(1:p-1, function(k)
k * n + rm))
pays <- c("algeria", "egypt", "libya", "morocco")
X <- X[, !(colnames(X) %in% pays)]
Y <- Y[-rm,] ; X <- X[-indices,]
n <- nrow(Y) ; p <- ncol(Y) ; d <- ncol(X)
X <- X[, -c(2:9)] ; X <- X[,c(9:11)]
sites_effects <- diag(1, n, n) ; sites_effects <- sites_effects[,-1]
years_effects <- diag(1, p, p) ; years_effects <- years_effects[,-1]
X <- cbind(rep(1, n*p), covmat(n, p, R = sites_effects, C = years_effects, E = X))
q <- 2
################################################################################
vecY <- MatrixToVector(Y)
fit <- lm(log(1 + vecY) ~ -1 + X, na.action = na.exclude)
B <- as.matrix(fit$coefficients)
res.vec <- ifelse(is.na(vecY), 0, fit$residuals)
res.mat <- VectorToMatrix(res.vec, n, p)
U <- ifelse(Y == 0, 0, 1)
vecU <- MatrixToVector(U)
fit.logit <- glm(vecU ~ -1 + X, family = "binomial", na.action = na.exclude)
D <- as.matrix(fit.logit$coefficients)
svdM <- svd(res.mat, nu = q, nv = p)
C <- svdM$v[, 1:q, drop = FALSE] %*% diag(svdM$d[1:q], nrow = q, ncol = q)/sqrt(n)
M  <- svdM$u[, 1:q, drop = FALSE] %*% diag(svdM$d[1:q], nrow = q, ncol = q) %*% t(svdM$v[1:q, 1:q, drop = FALSE])
Sigma <- C%*%t(C) + summary(fit)$sigma**2 * diag(p)
diag(q) - t(C)%*% solve(Sigma) %*% C
S <- rep(1,n) %o% diag(diag(q) - t(C)%*% solve(Sigma) %*% C)
Init <- list(B = B, D = D, C = C, M = M, S = S)
config <- list(algorithm = "MMA", backend = "nlopt", maxeval = 1e5,
ftol_abs = 1e-10, xtol_abs = 1e-10, maxtime = -1, trace = 1, ftol_rel = 1e-15, xtol_rel = 1e-15)
test <- Miss.ZIPLNPCA(Y, X, q, config = config,
params = Init, tolS = list(lower = 0, upper = 1))
test2 <- Miss.ZIPLNPCA(Y, X, q, config = config,
params = Init, tolS = list(lower = 0, upper = Inf))
test_init <- Miss.ZIPLNPCA(Y, X, q, config = config,
tolS = list(lower = 0, upper = 1))
load("~/Code/Souchet_SmallMean_SitesYearsEffects.Rdata")
## Steps
B <- test_Steps$mStep$beta ; XB <- VectorToMatrix(X%*%B, n, p)
Y.pred <- ifelse(is.na(Y), test_Steps$eStep$xi*exp(XB), Y)
ref <- n*colMeans(Y, na.rm = TRUE)
predTest1 <- ifelse(is.na(Y), test$eStep$xi*test$pred$A, Y)
predTest2 <- ifelse(is.na(Y), test2$eStep$xi*test2$pred$A, Y)
predTestInit <- ifelse(is.na(Y), test_init$eStep$xi*test_init$pred$A, Y)
predSteps <- ifelse(is.na(Y), test_Steps$eStep$xi*test_Steps$pred$A, Y)
plot(ref, type = "b", ylim = c(min(ref), max(ref)))
lines(colSums(predTest1), type = "b", col = "red")
lines(colSums(Y.pred), type = "b", col = "green")
lines(colSums(predTest2), type = "b", col = "yellow")
lines(colSums(predTestInit), type = "b", col = "purple")
lines(colSums(predSteps), type = "b", col = "blue")
## Étapes : calcul des prédictions
B <- test_Steps$mStep$beta
XB <- VectorToMatrix(X %*% B, n, p)
Y.pred <- ifelse(is.na(Y), test_Steps$eStep$xi * exp(XB), Y)
# Référence : moyenne colonne de Y
ref <- n * colMeans(Y, na.rm = TRUE)
# Différentes prédictions
predTest1     <- ifelse(is.na(Y), test$eStep$xi * test$pred$A, Y)
predTest2     <- ifelse(is.na(Y), test2$eStep$xi * test2$pred$A, Y)
predTestInit  <- ifelse(is.na(Y), test_init$eStep$xi * test_init$pred$A, Y)
predSteps     <- ifelse(is.na(Y), test_Steps$eStep$xi * test_Steps$pred$A, Y)
# Couleurs personnalisées (palette douce et contrastée)
