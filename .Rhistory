if (is.null(config)){config <- PLNPCA_param()$config_optim}
if (is.null(tolxi)){tolxi <- 1e-04}
if (is.null(tolLogS)){tolLogS <- 0}
uBound <- c(rep(Inf, (2*d)+(p*q)+(n*q)), rep(tolLogS, n*q))
if (is.null(tolxi)){tolxi <- 1e-04}
if (is.null(tolLogS)){tolLogS <- 0}
