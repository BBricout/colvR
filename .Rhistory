## 0) Voir toutes tes librairies actives et repérer des colvR “fantômes”
print(.libPaths())
sapply(.libPaths(), function(L) dir.exists(file.path(L, "colvR")))
## 1) Supprimer verrous & versions existantes partout
unlink(file.path(.libPaths(), "00LOCK*"), recursive = TRUE, force = TRUE)
invisible(lapply(.libPaths(), function(L) {
d <- file.path(L, "colvR")
if (dir.exists(d)) unlink(d, recursive = TRUE, force = TRUE)
}))
## 2) Créer une librairie propre et la mettre en tête de .libPaths()
dir.create("~/Rlibs_cygne_clean", showWarnings = FALSE)
.libPaths(c(normalizePath("~/Rlibs_cygne_clean"), .libPaths()))
print(.libPaths())  # vérifie que ~/Rlibs_cygne_clean est en 1er
## 3) Réinstaller colvR “proprement”
if (!requireNamespace("remotes", quietly = TRUE)) install.packages("remotes")
# Astuce: éviter la doc HTML (qui génère colvR.rdb/rdx) + installation staged
remotes::install_github(
"BBricout/colvR",
build_vignettes = FALSE,
force = TRUE, upgrade = "never",
INSTALL_opts = c("--no-html", "--no-multiarch", "--no-staged-install")
)
## 4) Vérifications basiques (sans appeler le système d’aide)
library(colvR, lib.loc = "~/Rlibs_cygne_clean")
exists("Predictions", where = asNamespace("colvR"), inherits = FALSE)
# a) Installer le package torch si besoin
if (!requireNamespace("torch", quietly = TRUE)) install.packages("torch")
# b) Charger et installer la biblio libtorch (CPU par défaut)
library(torch)
torch::install_torch()
